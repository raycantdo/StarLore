<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.Button?>
<AnchorPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="com.starlore.starlore.ShootingStarController" prefWidth="800" prefHeight="600" style="-fx-background-color: #0b0b19;">
   <children>
      <Canvas fx:id="gameCanvas" width="800" height="600" />
      <Button fx:id="backButton" text="←"
              onAction="#backToHub"
              layoutX="16" layoutY="16"
              style="-fx-background-color: transparent;
                       -fx-text-fill: white;
                       -fx-font-size: 24;
                       -fx-cursor: hand;"/>
      <Label fx:id="scoreLabel" layoutX="30.0" layoutY="20.0" text="Score: 0" textFill="WHITE">
         <font>
            <Font name="Verdana Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="timerLabel" layoutX="425" layoutY="20"
             text="⏱ 60s" textFill="WHITE">
         <font><Font name="Verdana Bold" size="18"/></font>
      </Label>

      <!-- Combo -->
      <Label fx:id="comboLabel" layoutX="750" layoutY="20"
             text="Combo: x1" textFill="#f0d060">
         <font><Font name="Verdana Bold" size="18"/></font>
      </Label>

   </children>
</AnchorPane>