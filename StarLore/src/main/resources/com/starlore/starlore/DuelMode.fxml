<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom, #050816, #0a0a2e, #000000);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.starlore.starlore.DuelController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0">
         <top>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-padding: 16 24 12 24;" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #afc9ff;" text="👤 YOU" />
                        <Label fx:id="playerScoreLabel" style="-fx-font-size: 22;-fx-font-weight: bold; -fx-text-fill: white;" text="Score: 0" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="constellationNameLabel" style="-fx-font-size: 18; -fx-text-fill: #f0d060;                                               -fx-font-weight: bold;" text="?" />
                        <Label fx:id="timerLabel" style="-fx-font-size: 28; -fx-font-weight: bold;                                               -fx-text-fill: white;" text="⏱ 0:30" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_RIGHT" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;                                               -fx-text-fill: #ffaaaa;" text="🤖 AI" />
                        <Label fx:id="aiScoreLabel" style="-fx-font-size: 22; -fx-font-weight: bold;                                               -fx-text-fill: white;" text="Score: 0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </top>
         <center>
            <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <StackPane prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                     <children>
                        <Canvas fx:id="playerCanvas" height="580.0" width="490.0" />
                     </children>
                  </StackPane>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #2a2a5a;-fx-min-width: 2; -fx-max-width: 2;">
                     <children>
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold;                                               -fx-text-fill: #afc9ff;                                               -fx-rotate: 90;" text="VS" />
                     </children>
                  </VBox>
                  <StackPane prefHeight="150.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Canvas fx:id="aiCanvas" height="580.0" width="490.0" />
                     </children>
                  </StackPane>
               </children>
            </HBox>
         </center>
      </BorderPane>
      <StackPane fx:id="countdownOverlay" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: rgba(0,0,0,0.85);">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20">
               <children>
                  <Label fx:id="constellationRevealLabel" style="-fx-font-size: 28; -fx-text-fill: #f0d060;                                       -fx-font-weight: bold;" text="Connect: ORION" />
                  <Label fx:id="countdownLabel" style="-fx-font-size: 120; -fx-font-weight: bold;                                       -fx-text-fill: white;" text="3" />
               </children>
            </VBox>
         </children>
      </StackPane>
      <StackPane fx:id="resultOverlay" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: rgba(0,0,0,0.88);" visible="false">
         <children>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="28.0">
               <children>
                  <Label fx:id="resultLabel" style="-fx-font-size: 52; -fx-font-weight: bold;                                       -fx-text-fill: white;" text="⚔️ YOU WIN!" />
                  <Label fx:id="resultScoreLabel" style="-fx-font-size: 20; -fx-text-fill: #afc9ff;" text="Your Score: 0 — AI Score: 0" />
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="24.0">
                     <children>
                        <Button fx:id="rematchBtn" mnemonicParsing="false" onAction="#rematch" style="-fx-background-color: #0a1a6e; -fx-text-fill: white;
                                               -fx-font-size: 16;
                                               -fx-padding: 12 32;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;" text="⚔️ Rematch" />
                        <Button fx:id="backBtn" mnemonicParsing="false"  onAction="#backToHub"
                                style="-fx-background-color: #2a2a5a;
                                               -fx-text-fill: white;
                                               -fx-font-size: 16;
                                               -fx-padding: 12 32;
                                               -fx-background-radius: 8;
                                               -fx-cursor: hand;" text="🏠 Back to Hub" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
