<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #020308;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.starlore.starlore.DuelController">
   <children>
      <!-- LAYER 1: Interactive Celestial Atlas Map -->
      <StackPane fx:id="mapOverlay">
         <children>
            <Canvas fx:id="mapCanvas" height="700.0" width="1000.0" />

            <!-- Top HUD Bar (Styled after user reference image) -->
            <VBox alignment="TOP_CENTER" pickOnBounds="false">
               <children>
                  <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 16 24 10 24;" pickOnBounds="false">
                     <children>
                        <!-- Level Badge -->
                        <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: rgba(6, 25, 90, 0.85); -fx-background-radius: 20; -fx-padding: 6 16; -fx-border-color: #38bdf8; -fx-border-radius: 20; -fx-border-width: 1.5;">
                           <children>
                              <Label text="★ 1" style="-fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #38bdf8;" />
                              <Label text="0/120" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                           </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Astral Energy Bar -->
                        <HBox alignment="CENTER" spacing="6.0" style="-fx-background-color: rgba(2, 132, 199, 0.85); -fx-background-radius: 20; -fx-padding: 6 16; -fx-border-color: #38bdf8; -fx-border-radius: 20; -fx-border-width: 1.5;">
                           <children>
                              <Label text="⚡" style="-fx-font-size: 14px; -fx-text-fill: #38bdf8;" />
                              <Label text="100/100" style="-fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: white;" />
                           </children>
                        </HBox>

                        <!-- Stardust / Gems -->
                        <HBox alignment="CENTER" spacing="6.0" style="-fx-background-color: rgba(109, 40, 217, 0.85); -fx-background-radius: 20; -fx-padding: 6 16; -fx-border-color: #c084fc; -fx-border-radius: 20; -fx-border-width: 1.5;">
                           <children>
                              <Label text="✦" style="-fx-font-size: 14px; -fx-text-fill: #fcd34d;" />
                              <Label fx:id="dustHudLabel" text="0 DUST" style="-fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: white;" />
                           </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Compass Re-center Button -->
                        <Button fx:id="compassBtn" onAction="#recenterOnSelected" text="🧭" style="-fx-background-color: rgba(14, 165, 233, 0.8); -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 20; -fx-cursor: hand; -fx-min-width: 40; -fx-min-height: 40;" />

                        <!-- Back to Hub Button -->
                        <Button fx:id="hubBtn" onAction="#backToHub" text="🏠 Hub" style="-fx-background-color: rgba(15, 23, 42, 0.85); -fx-text-fill: #38bdf8; -fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20; -fx-border-color: #38bdf8; -fx-border-radius: 20; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Bottom Floating Constellation Action Card (Styled like modern game modal) -->
            <VBox alignment="BOTTOM_CENTER" spacing="10.0" style="-fx-padding: 0 0 20 0;" pickOnBounds="false">
               <children>
                  <VBox alignment="CENTER" maxWidth="520.0" spacing="12.0" style="-fx-background-color: rgba(3, 11, 46, 0.92); -fx-background-radius: 24; -fx-border-color: #38bdf8; -fx-border-radius: 24; -fx-border-width: 1.8; -fx-padding: 16 28; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.4), 22, 0.3, 0, 4);">
                     <children>
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Label fx:id="constellationTitleLabel" text="✦ ARIES — THE RAM ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffd65a;" />
                              <Label fx:id="constellationStatusBadge" text="🌑 DORMANT" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-background-color: rgba(148, 163, 184, 0.2); -fx-padding: 3 10; -fx-background-radius: 10;" />
                           </children>
                        </HBox>

                        <Label fx:id="constellationDescLabel" text="Connect the stars to awaken this celestial constellation." style="-fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-text-fill: #cbd5e1; -fx-wrap-text: true; -fx-text-alignment: center;" />

                         <HBox alignment="CENTER" spacing="12.0">
                            <children>
                               <Button fx:id="serverLobbyBtn" onAction="#openServerLobby" text="🌐 Online Lobby" style="-fx-background-color: linear-gradient(to right, #059669, #10b981); -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 10 18; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.45), 10, 0, 0, 2);" />
                               <Button fx:id="friendsModeBtn" onAction="#startFriendsMode" text="👥 Friends (P2P)" style="-fx-background-color: linear-gradient(to right, #0284c7, #0369a1); -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 10 18; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(2, 132, 199, 0.4), 10, 0, 0, 2);" />
                               <Button fx:id="aiModeBtn" onAction="#startAiMode" text="🤖 Play with AI" style="-fx-background-color: linear-gradient(to right, #7c3aed, #6d28d9); -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 10 18; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(124, 58, 237, 0.5), 10, 0, 0, 2);" />
                            </children>
                         </HBox>

                        <Label text="Drag map in any direction to explore the night sky" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-text-fill: #64748b;" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- LAYER 2: Constellation Duel Gameplay -->
      <BorderPane fx:id="gamePane" visible="false" style="-fx-background-color: #020308;">
         <top>
            <HBox alignment="CENTER" style="-fx-padding: 14 24 10 24; -fx-background-color: rgba(5, 10, 25, 0.88); -fx-border-color: rgba(56, 189, 248, 0.25); -fx-border-width: 0 0 1.5 0;">
               <children>
                  <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="player1TagLabel" text="✦ YOU" style="-fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #38bdf8;" />
                        <Label fx:id="playerScoreLabel" text="Score: 0" style="-fx-font-family: 'Verdana'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <Label fx:id="playerProgressLabel" text="★ 0 Stars Connected" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="duelConstellationNameLabel" text="✦ ARIES" style="-fx-font-family: 'Verdana'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffd65a;" />
                        <Label fx:id="timerLabel" text="⏱ 0:30" style="-fx-font-family: 'Verdana'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <Label fx:id="turnIndicatorLabel" text="Click 2 stars to connect a link" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                     </children>
                  </VBox>
                  <VBox fx:id="opponentHeader" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="opponentTagLabel" text="✦ AI" style="-fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #c084fc;" />
                        <Label fx:id="aiScoreLabel" text="Score: 0" style="-fx-font-family: 'Verdana'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <Label fx:id="opponentProgressLabel" text="★ 0 Stars Connected" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #fbbf24;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </top>
         <center>
            <HBox alignment="CENTER">
               <children>
                  <StackPane alignment="CENTER" HBox.hgrow="ALWAYS">
                     <children>
                        <Canvas fx:id="playerCanvas" height="560.0" width="480.0" />
                     </children>
                  </StackPane>
                  <VBox fx:id="versusDivider" style="-fx-background-color: rgba(56, 189, 248, 0.3); -fx-min-width: 2; -fx-max-width: 2;" />
                  <StackPane fx:id="opponentBoard" alignment="CENTER" HBox.hgrow="ALWAYS">
                     <children>
                        <Canvas fx:id="aiCanvas" height="560.0" width="480.0" />
                     </children>
                  </StackPane>
               </children>
            </HBox>
         </center>
         <bottom>
            <HBox alignment="CENTER" style="-fx-padding: 10 0 14 0;">
               <children>
                  <Button onAction="#returnToMap" text="✦ Abandon &amp; Return to Map" style="-fx-background-color: rgba(15, 23, 42, 0.85); -fx-text-fill: #94a3b8; -fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-padding: 8 20; -fx-background-radius: 20; -fx-border-color: rgba(148, 163, 184, 0.3); -fx-border-radius: 20; -fx-cursor: hand;" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>

      <!-- LAYER 3: Result Overlay -->
      <StackPane fx:id="resultOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.88);">
         <children>
            <VBox alignment="CENTER" spacing="22.0">
               <children>
                  <Label fx:id="resultLabel" text="✦ CONSTELLATION ENLIGHTENED! ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #ffd65a; -fx-effect: dropshadow(gaussian, #f59e0b, 20, 0.5, 0, 0);" />
                  <Label fx:id="resultScoreLabel" text="You illuminated all stars and earned +50 Star Dust!" style="-fx-font-family: 'Verdana'; -fx-font-size: 18px; -fx-text-fill: #b8d9ff;" />
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button onAction="#rematch" text="↻ Rematch" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 18; -fx-cursor: hand;" />
                        <Button onAction="#returnToMap" text="✦ Star Map" style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 18; -fx-cursor: hand;" />
                        <Button onAction="#backToHub" text="🏠 Back to Hub" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 18; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- LAYER 4: Online Duel Server Lobby Overlay -->
      <StackPane fx:id="serverLobbyOverlay" visible="false" style="-fx-background-color: rgba(2, 6, 23, 0.88);">
         <children>
            <VBox alignment="CENTER" maxWidth="660.0" maxHeight="600.0" spacing="14.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(8, 18, 48, 0.97), rgba(3, 8, 24, 0.98)); -fx-background-radius: 24; -fx-border-color: linear-gradient(to bottom right, #38bdf8, #818cf8, #34d399); -fx-border-radius: 24; -fx-border-width: 1.8; -fx-padding: 22 30; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.38), 32, 0.25, 0, 4);">
               <children>
                  <!-- Header with Title & Player Identity Pill -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label text="✦ CELESTIAL DUEL LOBBY ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ffd65a; -fx-effect: dropshadow(gaussian, rgba(245, 158, 11, 0.5), 10, 0, 0, 1);" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="6.0" style="-fx-background-color: rgba(14, 165, 233, 0.15); -fx-background-radius: 14; -fx-border-color: rgba(56, 189, 248, 0.4); -fx-border-radius: 14; -fx-border-width: 1; -fx-padding: 4 12;">
                           <children>
                              <Label text="👤" style="-fx-font-size: 11px;" />
                              <Label fx:id="myOnlineTagLabel" text="✦ Logged in: YOU" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" />
                           </children>
                        </HBox>
                        <Button onAction="#closeServerLobby" text="✕" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-background-radius: 20; -fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-cursor: hand;" />
                     </children>
                  </HBox>

                  <!-- Live Server Connection Status & Constellation Arena Banner -->
                  <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: rgba(15, 23, 42, 0.75); -fx-padding: 8 16; -fx-background-radius: 12; -fx-border-color: rgba(56, 189, 248, 0.2); -fx-border-radius: 12; -fx-border-width: 1;">
                     <children>
                        <Label text="Arena:" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" />
                        <Label fx:id="lobbyConstellationLabel" text="ARIES (4 Stars)" style="-fx-font-family: 'Verdana'; -fx-font-size: 11.5px; -fx-text-fill: #ffd65a; -fx-font-weight: bold;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="serverStatusLabel" text="🟢 Connected to Cosmos" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #34d399;" />
                     </children>
                  </HBox>

                  <!-- Online Stargazers List with Clear Instructions -->
                  <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Online Stargazers Ready for Versus Duel:" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #cbd5e1;" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Label text="👉 Click CHALLENGE on any stargazer to duel" style="-fx-font-family: 'Verdana'; -fx-font-size: 10.5px; -fx-text-fill: #38bdf8;" />
                           </children>
                        </HBox>
                        <ListView fx:id="serverUsersListView" prefHeight="230.0" style="-fx-background-color: rgba(10, 18, 38, 0.7); -fx-control-inner-background: rgba(10, 18, 38, 0.7); -fx-background-radius: 14; -fx-border-color: rgba(56, 189, 248, 0.22); -fx-border-radius: 14; -fx-padding: 6;" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>

                  <!-- Bottom Actions -->
                  <HBox alignment="CENTER" spacing="16.0">
                     <children>
                        <Button fx:id="challengePlayerBtn" onAction="#challengeSelectedPlayer" text="⚔️ Challenge to Duel" style="-fx-background-color: linear-gradient(to right, #059669, #10b981); -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 26; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.5), 12, 0, 0, 2);" />
                        <Button onAction="#refreshServerUsers" text="⟳ Refresh" style="-fx-background-color: rgba(30, 41, 59, 0.9); -fx-text-fill: #e2e8f0; -fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-padding: 10 20; -fx-background-radius: 20; -fx-border-color: rgba(148, 163, 184, 0.25); -fx-border-radius: 20; -fx-cursor: hand;" />
                        <Button onAction="#closeServerLobby" text="Cancel" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-padding: 10 16; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- LAYER 5: In-Scene Incoming Challenge Modal (Active Player Screen) -->
      <StackPane fx:id="incomingChallengeOverlay" visible="false" style="-fx-background-color: rgba(2, 6, 23, 0.92);">
         <children>
            <VBox alignment="CENTER" maxWidth="520.0" spacing="18.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(14, 23, 56, 0.98), rgba(3, 8, 24, 0.98)); -fx-background-radius: 24; -fx-border-color: linear-gradient(to bottom right, #ffd65a, #38bdf8, #10b981); -fx-border-radius: 24; -fx-border-width: 2.2; -fx-padding: 30 36; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.45), 36, 0.3, 0, 4);">
               <children>
                  <Label text="✦ CELESTIAL DUEL INVITATION ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ffd65a; -fx-letter-spacing: 2; -fx-effect: dropshadow(gaussian, rgba(245, 158, 11, 0.6), 10, 0, 0, 1);" />

                  <!-- Challenger Avatar Orb & Name -->
                  <HBox alignment="CENTER" spacing="14.0">
                     <children>
                        <StackPane prefHeight="50.0" prefWidth="50.0">
                           <children>
                              <Label text="⚔️" style="-fx-font-size: 30px; -fx-effect: dropshadow(gaussian, #38bdf8, 12, 0.4, 0, 0);" />
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                           <children>
                              <Label fx:id="incomingChallengerLabel" text="Stargazer Raya" style="-fx-font-family: 'Verdana'; -fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: white;" />
                              <Label text="has challenged you to a live Versus Duel!" style="-fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-text-fill: #38bdf8;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Arena Info Box -->
                  <VBox alignment="CENTER" spacing="4.0" style="-fx-background-color: rgba(30, 41, 59, 0.5); -fx-padding: 10 20; -fx-background-radius: 12; -fx-border-color: rgba(56, 189, 248, 0.25); -fx-border-radius: 12;">
                     <children>
                        <Label fx:id="incomingArenaLabel" text="✦ Arena: ARIES (4 Stars Arena) ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #fcd34d;" />
                        <Label text="Race simultaneously to connect the stars! First to complete wins." style="-fx-font-family: 'Verdana'; -fx-font-size: 10.5px; -fx-text-fill: #94a3b8;" />
                     </children>
                  </VBox>

                  <!-- Accept / Decline Action Buttons -->
                  <HBox alignment="CENTER" spacing="18.0">
                     <children>
                        <Button fx:id="acceptChallengeBtn" onAction="#acceptIncomingChallenge" text="⚔️ ACCEPT DUEL" style="-fx-background-color: linear-gradient(to right, #059669, #10b981); -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 32; -fx-background-radius: 22; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.6), 14, 0, 0, 2);" />
                        <Button fx:id="declineChallengeBtn" onAction="#declineIncomingChallenge" text="✕ Decline" style="-fx-background-color: rgba(30, 41, 59, 0.85); -fx-text-fill: #f87171; -fx-font-family: 'Verdana'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 22; -fx-border-color: rgba(239, 68, 68, 0.4); -fx-border-radius: 22; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- LAYER 6: In-Scene Outgoing Challenge Waiting Modal -->
      <StackPane fx:id="waitingChallengeOverlay" visible="false" style="-fx-background-color: rgba(2, 6, 23, 0.90);">
         <children>
            <VBox alignment="CENTER" maxWidth="480.0" spacing="18.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(10, 18, 48, 0.98), rgba(2, 6, 20, 0.98)); -fx-background-radius: 24; -fx-border-color: linear-gradient(to bottom right, #38bdf8, #818cf8); -fx-border-radius: 24; -fx-border-width: 2; -fx-padding: 30 36; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.4), 32, 0.25, 0, 4);">
               <children>
                  <Label text="✦ CHALLENGE DISPATCHED ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-letter-spacing: 2;" />
                  <Label fx:id="waitingTargetLabel" text="Waiting for Tasnim to respond..." style="-fx-font-family: 'Verdana'; -fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;" />
                  <Label fx:id="waitingArenaLabel" text="Arena: ARIES (4 Stars)" style="-fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-text-fill: #ffd65a;" />
                  <Label text="✦ Starlight connection awaiting response across the cosmos... ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-text-fill: #94a3b8;" />
                  <Button onAction="#cancelOutgoingChallenge" text="✕ Cancel Invitation" style="-fx-background-color: rgba(30, 41, 59, 0.9); -fx-text-fill: #cbd5e1; -fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-padding: 10 24; -fx-background-radius: 18; -fx-border-color: rgba(148, 163, 184, 0.3); -fx-border-radius: 18; -fx-cursor: hand;" />
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- LAYER 7: In-Scene Celestial Notice Overlay (Declined / Disconnected) -->
      <StackPane fx:id="challengeNoticeOverlay" visible="false" style="-fx-background-color: rgba(2, 6, 23, 0.88);">
         <children>
            <VBox alignment="CENTER" maxWidth="460.0" spacing="16.0" style="-fx-background-color: linear-gradient(to bottom right, rgba(16, 24, 52, 0.98), rgba(4, 10, 26, 0.98)); -fx-background-radius: 22; -fx-border-color: #38bdf8; -fx-border-radius: 22; -fx-border-width: 1.6; -fx-padding: 26 34; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.35), 28, 0.2, 0, 3);">
               <children>
                  <Label fx:id="noticeTitleLabel" text="✦ CHALLENGE NOTICE ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ffd65a;" />
                  <Label fx:id="noticeMessageLabel" text="Stargazer declined the duel invitation." textAlignment="CENTER" wrapText="true" style="-fx-font-family: 'Verdana'; -fx-font-size: 13px; -fx-text-fill: #f1f5f9;" />
                  <Button onAction="#dismissChallengeNotice" text="✦ Continue" style="-fx-background-color: linear-gradient(to right, #0284c7, #0369a1); -fx-text-fill: white; -fx-font-family: 'Verdana'; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 9 26; -fx-background-radius: 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(2, 132, 199, 0.4), 8, 0, 0, 1);" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</StackPane>
