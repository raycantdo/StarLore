<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.starlore.starlore.BattleController">
    <children>
        <ImageView fx:id="backgroundImageView" fitHeight="700.0" fitWidth="1000.0" pickOnBounds="true" preserveRatio="false" />

        <ImageView fx:id="medusaSprite" fitHeight="280.0" fitWidth="280.0" layoutX="650.0" layoutY="280.0" pickOnBounds="true" preserveRatio="true" />
        <ImageView fx:id="perseusSprite" fitHeight="220.0" fitWidth="220.0" layoutX="100.0" layoutY="340.0" pickOnBounds="true" preserveRatio="true" />

        <HBox layoutX="50.0" layoutY="30.0" prefWidth="900.0" spacing="300.0">
            <children>
                <VBox spacing="5.0">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, black, 3, 1.0, 0, 0);" text="PERSEUS" textFill="WHITE" />
                    <ProgressBar fx:id="playerHealthBar" prefHeight="25.0" prefWidth="300.0" progress="1.0" style="-fx-accent: #32CD32;" />
                </VBox>
                <VBox alignment="TOP_RIGHT" spacing="5.0">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, black, 3, 1.0, 0, 0);" text="MEDUSA" textFill="WHITE" />
                    <ProgressBar fx:id="enemyHealthBar" prefHeight="25.0" prefWidth="300.0" progress="1.0" style="-fx-accent: #DC143C;" />
                </VBox>
            </children>
        </HBox>

        <Label fx:id="battleTextLabel" alignment="CENTER" layoutX="100.0" layoutY="540.0" prefHeight="40.0" prefWidth="800.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 10;" text="A wild Medusa appears!" textFill="GOLD" />

        <HBox fx:id="actionMenu" alignment="CENTER" layoutX="277.0" layoutY="585.0" prefHeight="75.0" prefWidth="366.0" spacing="30.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onSwordAttack" prefHeight="70.0" prefWidth="70.0" style="-fx-font-size: 28px; -fx-background-radius: 30; -fx-background-color: #4a4a4a; -fx-text-fill: white;" text="⚔" textAlignment="CENTER" />
                <Button mnemonicParsing="false" onAction="#onShieldBlock" prefHeight="68.0" prefWidth="67.0" style="-fx-font-size: 28px; -fx-background-radius: 30; -fx-background-color: #4a4a4a; -fx-text-fill: white;" text="🛡">
               <font>
                  <Font size="5.0" />
               </font></Button>

            </children>
        </HBox>

        <Button fx:id="backButton" layoutX="400.0" layoutY="600.0" mnemonicParsing="false" onAction="#returnToHub" prefHeight="60.0" prefWidth="200.0" style="-fx-font-size: 20px; -fx-background-color: gold; -fx-font-weight: bold;" text="RETURN TO HUB" visible="false" />
    </children>
</AnchorPane>
