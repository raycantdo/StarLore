<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="700.0" prefWidth="950.0"
            style="-fx-background-color: #020308;"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.starlore.starlore.HelloController">
   <children>
      <Canvas fx:id="astrolabeCanvas" height="700.0" width="950.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

      <VBox alignment="CENTER" spacing="16.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="50.0">
         <children>
            <!-- Heavy Cinematic Typography with Gradients & Dark Shadows -->
            <Label text="StarLore"
                   style="-fx-font-family: 'Georgia'; -fx-font-size: 72px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to bottom, #ffffff, #38bdf8); -fx-effect: dropshadow(gaussian, black, 8, 0.7, 2, 2);" />
            <Label text="CONSTELLATION CHRONICLES"
                   style="-fx-font-family: 'Verdana'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #bae6fd; -fx-letter-spacing: 6; -fx-effect: dropshadow(gaussian, black, 5, 0.8, 1, 1);" />
            <Label text="THE HEAVENS AWAIT YOUR NAME"
                   style="-fx-font-family: 'Verdana'; -fx-font-size: 14px; -fx-text-fill: #94a3b8; -fx-letter-spacing: 4; -fx-effect: dropshadow(gaussian, black, 4, 0.8, 1, 1);" />

            <Pane prefHeight="15.0" />

            <!-- Enlarged Holographic Input -->
            <StackPane alignment="CENTER" maxWidth="540.0" prefWidth="540.0">
               <children>
                  <VBox alignment="CENTER" spacing="0.0">
                     <children>
                        <TextField fx:id="nameField" alignment="CENTER" maxWidth="500.0" prefHeight="60.0"
                                   onAction="#checkPlayer"
                                   promptText="ENTER YOUR ASTRONOMER NAME"
                                   style="-fx-background-color: rgba(10, 15, 30, 0.6);
                                          -fx-text-fill: #ffffff;
                                          -fx-font-family: 'Verdana';
                                          -fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-prompt-text-fill: rgba(148, 163, 184, 0.6);
                                          -fx-border-color: rgba(56, 189, 248, 0.3);
                                          -fx-border-width: 0 0 1 0;
                                          -fx-padding: 0 10 8 10;
                                          -fx-effect: dropshadow(gaussian, black, 6, 0.6, 1, 1);" />

                        <Pane fx:id="hologramBaseLinePane" maxWidth="500.0" prefHeight="4.0">
                           <children>
                              <Line fx:id="neonBaseLine" startX="0.0" startY="2.0" endX="500.0" endY="2.0"
                                    stroke="#38bdf8" strokeWidth="3.0"
                                    style="-fx-effect: dropshadow(gaussian, #00f0ff, 12, 0.8, 0, 0);" />
                              <Line fx:id="scanPulseLine" startX="0.0" startY="2.0" endX="100.0" endY="2.0"
                                    stroke="#ffffff" strokeWidth="4.0"
                                    style="-fx-effect: dropshadow(gaussian, #ffffff, 15, 0.9, 0, 0);" />
                           </children>
                        </Pane>

                        <Label fx:id="hologramHint" text="✦ Press ENTER to project your astronomer identity ✦"
                               style="-fx-font-family: 'Verdana'; -fx-font-size: 14px; -fx-text-fill: #7dd3fc; -fx-opacity: 0.9; -fx-padding: 12 0 0 0; -fx-effect: dropshadow(gaussian, black, 4, 0.8, 1, 1);" />
                     </children>
                  </VBox>
               </children>
            </StackPane>

            <Pane prefHeight="20.0" />

            <HBox fx:id="orbsContainer" alignment="CENTER" spacing="45.0" prefHeight="105.0">
               <!-- Celestial Orbs -->
            </HBox>

            <Label fx:id="orbLoreLabel" alignment="CENTER"
                   text="Hover over a Celestial Core to harmonize with its astral frequency"
                   style="-fx-font-family: 'Verdana'; -fx-font-size: 16px; -fx-text-fill: #bae6fd; -fx-effect: dropshadow(gaussian, black, 5, 0.8, 1, 1);" />
         </children>
      </VBox>
   </children>
</AnchorPane>