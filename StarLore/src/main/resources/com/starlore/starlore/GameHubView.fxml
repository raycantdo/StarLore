<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #020308;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.starlore.starlore.GameHubController">
   <children>
      <!-- Layer 1: Procedural Constellation & Starfield Canvas -->
      <Canvas fx:id="hubCanvas" height="700.0" width="1000.0" />

      <!-- Layer 2: Main Game HUD -->
      <BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: transparent;" pickOnBounds="false">

         <!-- ─── TOP PLAYER HUD ──────────────────────── -->
         <top>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 25 40 0 40;" pickOnBounds="false">
               <children>
                  <!-- Player Stats Box (Like an RPG Health/Resource Bar) -->
                  <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: rgba(10, 15, 30, 0.75); -fx-background-radius: 30; -fx-border-color: rgba(56, 189, 248, 0.3); -fx-border-radius: 30; -fx-border-width: 1.5; -fx-padding: 5 20 5 5;">
                     <children>
                        <StackPane style="-fx-background-color: #0f172a; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50; -fx-border-color: #38bdf8; -fx-border-radius: 50; -fx-border-width: 2;">
                           <Label text="👤" style="-fx-font-size: 24px;" />
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                           <children>
                              <Label text="ASTRAL COMMANDER" style="-fx-font-family: 'Verdana'; -fx-font-size: 9px; -fx-text-fill: #94a3b8; -fx-letter-spacing: 2;" />
                              <Label fx:id="rankLabel" text="LVL 1 - STARGAZER" style="-fx-font-family: 'Verdana'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                              <Label fx:id="starDustLabel" text="✦ 0 DUST" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #fcd34d;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <Region HBox.hgrow="ALWAYS" />

                  <!-- Game System Buttons -->
                  <HBox spacing="15.0" alignment="CENTER">
                     <children>
                        <Button fx:id="leaderboardBtn" onAction="#openLeaderboard" text="🏆" style="-fx-background-color: rgba(10, 15, 30, 0.75); -fx-border-color: #fbbf24; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1.5; -fx-pref-width: 50; -fx-pref-height: 50; -fx-font-size: 20; -fx-text-fill: white; -fx-cursor: hand;" />
                        <Button fx:id="signOutBtn" onAction="#signOut" text="⏻" style="-fx-background-color: rgba(30, 10, 15, 0.75); -fx-border-color: #ef4444; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1.5; -fx-pref-width: 50; -fx-pref-height: 50; -fx-font-size: 20; -fx-text-fill: #ef4444; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </top>

         <!-- ─── CENTER: VERTICAL MODE BANNERS ──────────────────────── -->
         <center>
            <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 40;" pickOnBounds="false">
               <children>

                  <!-- BANNER 1: DUEL ARENA -->
                  <StackPane fx:id="duelCard" onMouseClicked="#launchDuelMode" prefWidth="210.0" prefHeight="420.0" maxHeight="420.0">
                     <children>
                        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20;">
                           <children>
                              <Label text="✦ PVP ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-letter-spacing: 3;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="⚔️" style="-fx-font-size: 65px; -fx-effect: dropshadow(gaussian, #38bdf8, 25, 0.6, 0, 0);" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="ARENA" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 36px; -fx-text-fill: #ffffff; -fx-letter-spacing: 2;" />
                              <Label text="CONSTELLATION DUEL" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" style="-fx-background-color: #38bdf8; -fx-opacity: 0.5;" />
                              <Label text="ENTER MATCH" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(56, 189, 248, 0.25); -fx-padding: 8 20; -fx-background-radius: 15;" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <!-- BANNER 2: STORY CAMPAIGN -->
                  <StackPane fx:id="storyCard" onMouseClicked="#launchStoryMode" prefWidth="210.0" prefHeight="420.0" maxHeight="420.0">
                     <children>
                        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20;">
                           <children>
                              <Label text="✦ PVE ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-letter-spacing: 3;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="📖" style="-fx-font-size: 65px; -fx-effect: dropshadow(gaussian, #c084fc, 25, 0.6, 0, 0);" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="CAMPAIGN" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 36px; -fx-text-fill: #ffffff; -fx-letter-spacing: 2;" />
                              <Label text="MYTHIC CHRONICLES" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #c084fc; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" style="-fx-background-color: #c084fc; -fx-opacity: 0.5;" />
                              <Label text="RESUME STORY" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(192, 132, 252, 0.25); -fx-padding: 8 20; -fx-background-radius: 15;" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <!-- BANNER 3: ARCADE -->
                  <StackPane fx:id="arcadeCard" onMouseClicked="#launchArcade" prefWidth="210.0" prefHeight="420.0" maxHeight="420.0">
                     <children>
                        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20;">
                           <children>
                              <Label text="✦ SCORE ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-letter-spacing: 3;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="🌠" style="-fx-font-size: 65px; -fx-effect: dropshadow(gaussian, #f87171, 25, 0.6, 0, 0);" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="ARCADE" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 36px; -fx-text-fill: #ffffff; -fx-letter-spacing: 2;" />
                              <Label text="METEOR HARVEST" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #f87171; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" style="-fx-background-color: #f87171; -fx-opacity: 0.5;" />
                              <Label text="PLAY NOW" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(248, 113, 113, 0.25); -fx-padding: 8 20; -fx-background-radius: 15;" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <!-- BANNER 4: ARCHIVES / QUIZ -->
                  <StackPane fx:id="quizCard" onMouseClicked="#launchMythQuiz" prefWidth="210.0" prefHeight="420.0" maxHeight="420.0">
                     <children>
                        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20;">
                           <children>
                              <Label text="✦ LORE ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-letter-spacing: 3;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="🔮" style="-fx-font-size: 65px; -fx-effect: dropshadow(gaussian, #34d399, 25, 0.6, 0, 0);" />
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="ORACLE" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 36px; -fx-text-fill: #ffffff; -fx-letter-spacing: 2;" />
                              <Label text="CELESTIAL QUIZ" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #34d399; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" style="-fx-background-color: #34d399; -fx-opacity: 0.5;" />
                              <Label text="CONSULT" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: rgba(52, 211, 153, 0.25); -fx-padding: 8 20; -fx-background-radius: 15;" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

               </children>
            </HBox>
         </center>
      </BorderPane>

      <!-- Full Screen Transition Overlays -->
      <StackPane fx:id="transitionOverlay" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: transparent;" visible="false" mouseTransparent="true">
         <children>
            <Canvas fx:id="transitionCanvas" height="700.0" width="1000.0" />
            <Label fx:id="transitionLabel" style="-fx-font-family: 'Verdana'; -fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, #38bdf8, 16, 0.7, 0, 0);" text="" visible="false" />
         </children>
      </StackPane>
   </children>
</StackPane>