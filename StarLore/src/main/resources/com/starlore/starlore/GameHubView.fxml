<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #020308;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.starlore.starlore.GameHubController">
   <children>
      <!-- Layer 1: Procedural Constellation & Starfield Canvas -->
      <Canvas fx:id="hubCanvas" height="700.0" width="1000.0" />

      <!-- Layer 2: Main Game HUD -->
      <BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: transparent;" pickOnBounds="false">

         <!-- ─── TOP PLAYER HUD ──────────────────────── -->
         <top>
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 25 40 0 40;" pickOnBounds="false">
               <children>
                  <!-- Player Stats Box (Like an RPG Health/Resource Bar) -->
                  <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: rgba(10, 15, 30, 0.75); -fx-background-radius: 30; -fx-border-color: rgba(56, 189, 248, 0.3); -fx-border-radius: 30; -fx-border-width: 1.5; -fx-padding: 5 20 5 5;">
                     <children>
                        <StackPane style="-fx-background-color: #0f172a; -fx-background-radius: 50; -fx-min-width: 50; -fx-min-height: 50; -fx-border-color: #38bdf8; -fx-border-radius: 50; -fx-border-width: 2;">
                           <Label text="👤" style="-fx-font-size: 24px;" />
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                           <children>
                              <Label text="ASTRAL COMMANDER" style="-fx-font-family: 'Verdana'; -fx-font-size: 9px; -fx-text-fill: #94a3b8; -fx-letter-spacing: 2;" />
                              <Label fx:id="rankLabel" text="LVL 1 - STARGAZER" style="-fx-font-family: 'Verdana'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                              <Label fx:id="starDustLabel" text="✦ 0 DUST" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #fcd34d;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <Region HBox.hgrow="ALWAYS" />

                  <!-- Game System Buttons -->
                  <HBox spacing="15.0" alignment="CENTER">
                     <children>
                        <Button fx:id="leaderboardBtn" onAction="#openLeaderboard" text="🏆" style="-fx-background-color: rgba(10, 15, 30, 0.75); -fx-border-color: #fbbf24; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1.5; -fx-pref-width: 50; -fx-pref-height: 50; -fx-font-size: 20; -fx-text-fill: white; -fx-cursor: hand;" />
                        <Button fx:id="signOutBtn" onAction="#signOut" text="⏻" style="-fx-background-color: rgba(30, 10, 15, 0.75); -fx-border-color: #ef4444; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 1.5; -fx-pref-width: 50; -fx-pref-height: 50; -fx-font-size: 20; -fx-text-fill: #ef4444; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </top>

         <!-- ─── CENTER: DIFFERENTIATED MODE BANNERS ──────────────────────── -->
         <center>
            <HBox alignment="CENTER" spacing="26.0" style="-fx-padding: 30;" pickOnBounds="false">
               <children>

                  <!-- BANNER 1: DUEL ARENA (PVP - Electric Blue & Cyan Shield Shape) -->
                  <StackPane fx:id="duelCard" onMouseClicked="#launchDuelMode" prefWidth="215.0" prefHeight="430.0" maxHeight="430.0">
                     <children>
                        <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 22 18;">
                           <children>
                              <Label text="⚔️ PVP ARENA" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-background-color: rgba(56, 189, 248, 0.15); -fx-padding: 4 12; -fx-background-radius: 12; -fx-border-color: rgba(56, 189, 248, 0.4); -fx-border-radius: 12; -fx-letter-spacing: 1.5;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <StackPane prefHeight="90.0">
                                 <children>
                                    <Label text="✦" style="-fx-font-size: 20px; -fx-text-fill: #38bdf8; -fx-opacity: 0.6; -fx-translate-y: -40; -fx-translate-x: -35;" />
                                    <Label text="✧" style="-fx-font-size: 16px; -fx-text-fill: #7dd3fc; -fx-opacity: 0.7; -fx-translate-y: 35; -fx-translate-x: 35;" />
                                    <Label text="⚔️" style="-fx-font-size: 64px; -fx-effect: dropshadow(gaussian, #38bdf8, 28, 0.65, 0, 0);" />
                                 </children>
                              </StackPane>
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="ARENA" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 34px; -fx-text-fill: #ffffff; -fx-letter-spacing: 2; -fx-effect: dropshadow(gaussian, black, 6, 0.8, 1, 1);" />
                              <Label text="CONSTELLATION DUEL" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #38bdf8; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" maxWidth="120.0" style="-fx-background-color: linear-gradient(to right, transparent, #38bdf8, transparent); -fx-opacity: 0.8;" />
                              <Label text="ENTER MATCH ❯" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: linear-gradient(to right, #0284c7, #0369a1); -fx-padding: 9 22; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.5), 12, 0.4, 0, 2);" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <!-- BANNER 2: STORY CAMPAIGN (PVE - Royal Purple Arched Portal Shape) -->
                  <StackPane fx:id="storyCard" onMouseClicked="#launchStoryMode" prefWidth="215.0" prefHeight="430.0" maxHeight="430.0">
                     <children>
                        <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 22 18;">
                           <children>
                              <Label text="✧ PVE SAGA ✧" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #c084fc; -fx-background-color: rgba(192, 132, 252, 0.15); -fx-padding: 4 12; -fx-background-radius: 12; -fx-border-color: rgba(192, 132, 252, 0.4); -fx-border-radius: 12; -fx-letter-spacing: 1.5;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <StackPane prefHeight="90.0">
                                 <children>
                                    <Label text="✦" style="-fx-font-size: 18px; -fx-text-fill: #c084fc; -fx-opacity: 0.6; -fx-translate-y: -35; -fx-translate-x: 35;" />
                                    <Label text="✧" style="-fx-font-size: 14px; -fx-text-fill: #e9d5ff; -fx-opacity: 0.7; -fx-translate-y: 35; -fx-translate-x: -35;" />
                                    <Label text="📖" style="-fx-font-size: 64px; -fx-effect: dropshadow(gaussian, #c084fc, 28, 0.65, 0, 0);" />
                                 </children>
                              </StackPane>
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="CHRONICLES" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 30px; -fx-text-fill: #ffffff; -fx-letter-spacing: 1.5; -fx-effect: dropshadow(gaussian, black, 6, 0.8, 1, 1);" />
                              <Label text="MYTHIC ODYSSEY" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #c084fc; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" maxWidth="120.0" style="-fx-background-color: linear-gradient(to right, transparent, #c084fc, transparent); -fx-opacity: 0.8;" />
                              <Label text="RESUME STORY ❯" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: linear-gradient(to right, #7c3aed, #6d28d9); -fx-padding: 9 22; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(192, 132, 252, 0.5), 12, 0.4, 0, 2);" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <!-- BANNER 3: ARCADE (Score & Rewards - Solar Gold Dynamic Blade Shape) -->
                  <StackPane fx:id="arcadeCard" onMouseClicked="#launchArcade" prefWidth="215.0" prefHeight="430.0" maxHeight="430.0">
                     <children>
                        <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 22 18;">
                           <children>
                              <Label text="☄️ HARVEST ☄️" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #fcd34d; -fx-background-color: rgba(252, 211, 77, 0.15); -fx-padding: 4 12; -fx-background-radius: 12; -fx-border-color: rgba(252, 211, 77, 0.4); -fx-border-radius: 12; -fx-letter-spacing: 1.5;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <StackPane prefHeight="90.0">
                                 <children>
                                    <Label text="✦" style="-fx-font-size: 18px; -fx-text-fill: #fde047; -fx-opacity: 0.7; -fx-translate-y: -38; -fx-translate-x: -30;" />
                                    <Label text="✧" style="-fx-font-size: 14px; -fx-text-fill: #fef08a; -fx-opacity: 0.8; -fx-translate-y: 35; -fx-translate-x: 30;" />
                                    <Label text="☄️" style="-fx-font-size: 64px; -fx-effect: dropshadow(gaussian, #f59e0b, 28, 0.65, 0, 0);" />
                                 </children>
                              </StackPane>
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="ARCADE" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 34px; -fx-text-fill: #ffffff; -fx-letter-spacing: 2; -fx-effect: dropshadow(gaussian, black, 6, 0.8, 1, 1);" />
                              <Label text="METEOR HARVEST" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #fcd34d; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" maxWidth="120.0" style="-fx-background-color: linear-gradient(to right, transparent, #f59e0b, transparent); -fx-opacity: 0.8;" />
                              <Label text="PLAY NOW ❯" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0f172a; -fx-background-color: linear-gradient(to right, #f59e0b, #fde047); -fx-padding: 9 22; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(245, 158, 11, 0.5), 12, 0.4, 0, 2);" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

                  <!-- BANNER 4: ARCHIVES / QUIZ (Stellar Lore - Astral Cyan Mystic Pedestal Shape) -->
                  <StackPane fx:id="quizCard" onMouseClicked="#launchMythQuiz" prefWidth="215.0" prefHeight="430.0" maxHeight="430.0">
                     <children>
                        <VBox alignment="CENTER" spacing="12.0" style="-fx-padding: 22 18;">
                           <children>
                              <Label text="✦ STELLAR LORE ✦" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #22d3ee; -fx-background-color: rgba(34, 211, 238, 0.15); -fx-padding: 4 12; -fx-background-radius: 12; -fx-border-color: rgba(34, 211, 238, 0.4); -fx-border-radius: 12; -fx-letter-spacing: 1.5;" />
                              <Region VBox.vgrow="ALWAYS" />
                              <StackPane prefHeight="90.0">
                                 <children>
                                    <Label text="✦" style="-fx-font-size: 18px; -fx-text-fill: #22d3ee; -fx-opacity: 0.6; -fx-translate-y: -35; -fx-translate-x: 35;" />
                                    <Label text="✧" style="-fx-font-size: 14px; -fx-text-fill: #a5f3fc; -fx-opacity: 0.7; -fx-translate-y: 35; -fx-translate-x: -35;" />
                                    <Label text="🔮" style="-fx-font-size: 64px; -fx-effect: dropshadow(gaussian, #06b6d4, 28, 0.65, 0, 0);" />
                                 </children>
                              </StackPane>
                              <Region VBox.vgrow="ALWAYS" />
                              <Label text="ORACLE" style="-fx-font-family: 'Impact', 'Arial Black', sans-serif; -fx-font-size: 34px; -fx-text-fill: #ffffff; -fx-letter-spacing: 2; -fx-effect: dropshadow(gaussian, black, 6, 0.8, 1, 1);" />
                              <Label text="CELESTIAL QUIZ" style="-fx-font-family: 'Verdana'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #22d3ee; -fx-letter-spacing: 1;" />
                              <Pane prefHeight="2.0" maxWidth="120.0" style="-fx-background-color: linear-gradient(to right, transparent, #06b6d4, transparent); -fx-opacity: 0.8;" />
                              <Label text="CONSULT ❯" style="-fx-font-family: 'Verdana'; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: linear-gradient(to right, #0891b2, #0e7490); -fx-padding: 9 22; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(6, 182, 212, 0.5), 12, 0.4, 0, 2);" />
                           </children>
                        </VBox>
                     </children>
                  </StackPane>

               </children>
            </HBox>
         </center>
      </BorderPane>

      <!-- Full Screen Transition Overlays -->
      <StackPane fx:id="transitionOverlay" style="-fx-background-color: transparent;" visible="false">
         <children>
            <Canvas fx:id="transitionCanvas" height="700.0" width="1000.0" />
            <Label fx:id="transitionLabel" style="-fx-font-family: 'Verdana'; -fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, #38bdf8, 16, 0.7, 0, 0);" text="" visible="false" />
         </children>
      </StackPane>
   </children>
</StackPane>